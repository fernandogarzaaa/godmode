# Environment variables read by godmode. All are optional; set only what you need.
# Copy to .env (git-ignored) or export in your shell. Never commit real values.

# Where godmode keeps traces, ledgers and task state (default: ./.godmode).
GODMODE_DATA_DIR=
# Port for `godmode-mcp --http` (default: 8787).
GODMODE_PORT=
# Python interpreter used to run vendored Python tools (default: python).
GODMODE_PYTHON=

# Auth (default: open, localhost console). Set GODMODE_REQUIRE_AUTH=1 to require
# a bearer token from the comma-separated GODMODE_TOKENS list.
GODMODE_REQUIRE_AUTH=
GODMODE_TOKENS=
# JSON array of OAuth authorization servers advertised to MCP clients.
GODMODE_AUTH_SERVERS=

# Build / maintenance scripts
# Release tag scripts/fetch-adam.mjs downloads (default: v1.2.0).
GODMODE_ADAM_TAG=
# Set to 1 to exclude AGPL-licensed vendors in scripts/sync-vendors.mjs (MIT-only build).
GODMODE_NO_AGPL=
