node_modules/
.godmode/
.skein/
.fastembed_cache/
.tmp-*/
adam_genome.json
adam_memory.db
*.db
*.log
.eve-output/
target/
.venv/
__pycache__/
# Standalone prebuilt outputs ARE committed.
# `target/` ignores every dir named target; to re-include just the prebuilt
# adam-mcp release binaries, unignore the dir chain, re-ignore the rest of the
# cargo target tree, then unignore the two binaries (order matters).
!vendors/adam/target/
vendors/adam/target/*
!vendors/adam/target/release/
!vendors/adam/target/release/adam-mcp.exe
!vendors/adam/target/release/adam-mcp
!vendors/genesis/dist/
!vendors/eve/dist/
